# Copy to .env.local and fill in. Do not commit .env.local.

# --- Clerk (Authentication) ---
# Publishable key: safe for browser; from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Secret key: server-only; from Clerk Dashboard -> API Keys (keep secret)
CLERK_SECRET_KEY=sk_test_...

# --- Supabase (Database) ---
# Project URL: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key: client-side (sb_publishable_...); respects RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server/worker only (sb_secret_...); bypasses RLS for imports and video worker (keep secret)
# SUPABASE_SECRET_KEY=sb_secret_...

# --- Edamam Recipe API (recipe search) ---
NEXT_PUBLIC_EDAMAM_APP_ID=your-edamam-app-id
NEXT_PUBLIC_EDAMAM_APP_KEY=your-edamam-app-key

# --- OpenAI (video worker only; not exposed to browser) ---
# Audio transcription (Whisper) — speech-to-text from uploaded video audio
OPENAI_AUDIO_TRANSCRIPTION_KEY=sk-...
# Recipe extraction (GPT-4.1 nano) — structured recipe from OCR + transcript
OPENAI_REASONING_API_KEY=sk-...
# Optional: TRANSCRIPTION_TIMEOUT_MS=60000
