# Copy to .env.local and fill in. Do not commit .env.local.

# --- Clerk (Authentication) ---
# Publishable key: safe for browser; from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Secret key: server-only; from Clerk Dashboard -> API Keys (keep secret)
CLERK_SECRET_KEY=sk_test_...

# --- Supabase (Database) ---
# Project URL: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key: client-side (sb_publishable_...); respects RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server/worker only (sb_secret_...); bypasses RLS for imports, FDC bulk load, and video worker (keep secret)
# SUPABASE_SECRET_KEY=sb_secret_...

# --- USDA FoodData Central (server-only; optional until resolver uses API) ---
# Sign up: https://fdc.nal.usda.gov/api-key-signup.html — never use NEXT_PUBLIC_* for API keys.
# USDA_FDC_API_KEY=...

# --- FDC bulk CSV import (npm run import:fdc) ---
# Defaults point at AI-Recipe-App/data/... relative to the repo; override if bundles live elsewhere.
# FDC_FOUNDATION_CSV_DIR=/absolute/path/to/FoodData_Central_foundation_food_csv_2025-12-18
# FDC_SR_LEGACY_CSV_DIR=/absolute/path/to/FoodData_Central_sr_legacy_food_csv_2018-04

# --- OpenAI (video worker only; not exposed to browser) ---
# Audio transcription (Whisper) — speech-to-text from uploaded video audio
OPENAI_AUDIO_TRANSCRIPTION_KEY=sk-...
# Recipe extraction (GPT-4.1 nano) — structured recipe from OCR + transcript
OPENAI_REASONING_API_KEY=sk-...
# Video worker timeouts, frame limits, and vision (blur/dup) behavior use defaults from the
# repo (lib/vision/config.ts, scripts/process-video-jobs.ts). You do not need extra env vars for normal use.
