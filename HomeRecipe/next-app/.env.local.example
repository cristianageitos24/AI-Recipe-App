# Copy to .env.local and fill in values. Do not commit .env.local.
# Names and sections mirror the app's working .env.local (no real secrets here).

# --- Clerk (Authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Clerk redirect URLs (must match app/(auth) routes + ClerkProvider) ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard/home
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard/home

# --- Supabase (Database) ---
# Third-Party Auth with Clerk session tokens (not JWT templates). See AUTHENTICATION.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: only if you use Supabase CLI against a linked remote (`supabase link` / `db push`)
# SUPABASE_DB_PASSWORD=

# --- OpenAI (server-only; video worker — never NEXT_PUBLIC_*) ---
OPENAI_AUDIO_TRANSCRIPTION_KEY=
OPENAI_REASONING_API_KEY=
# Nutrition AI fallback: optional; if unset, OPENAI_REASONING_API_KEY is used when present
# NUTRITION_ESTIMATE_OPENAI_API_KEY=

# --- Video worker tuning (optional; defaults are fine for most setups) ---
# VIDEO_MAX_DURATION_SECONDS=240
# VIDEO_LONG_WARN_SECONDS=120
# WORKER_LOCK_TIMEOUT_MINUTES=20
# VISION_SELECT_MODE=smart
# VISION_MIN_OCR_FRAMES=24
# VISION_MAX_OCR_FRAMES_CAP=120
# VISION_LLM_ENABLED=true
# VISION_LLM_MODEL=gpt-4.1-mini
# VISION_LLM_TIMEOUT_MS=90000
# VISION_KEEP_BLURRY_MIN_TEXT_LIKELIHOOD=0.35
# VISION_CROP_TEXT_REGIONS=false
# VISION_METRICS_ONLY=false
# RECIPE_URL_IMPORT_API_URL=http://localhost:8000

# --- USDA FoodData Central (server-only; never NEXT_PUBLIC_*) ---
FDC_API_KEY=
# USDA_FDC_API_KEY=
# Max outbound USDA HTTP calls per UTC hour (default 900 if unset)
# FDC_HOURLY_SOFT_CAP=900

# --- FDC bulk CSV import (npm run import:fdc) ---
# FDC_FOUNDATION_CSV_DIR=
# FDC_SR_LEGACY_CSV_DIR=

# --- Stripe (Billing / Subscriptions) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (or Dashboard webhook signing secret)
# STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_HOMERECIPE_MONTHLY=
STRIPE_PRICE_ID_HOMERECIPE_YEARLY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- RevenueCat (Apple IAP → profiles Pro sync; web webhook only, no RC SDK) ---
# Authorization header value configured in RevenueCat Dashboard → Project → Integrations → Webhooks.
# Production URL: https://<production-host>/api/webhooks/revenuecat
# Sandbox + production events both OK. Must match the Authorization header exactly (not HMAC).
# REVENUECAT_WEBHOOK_SECRET=
