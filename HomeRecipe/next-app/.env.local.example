# Copy to .env.local and fill in values. Do not commit .env.local.
# This file lists variable names only (no real secrets).

# --- Clerk (Authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# JWT template name for Supabase RLS (default: supabase). Required for inserts/updates that check auth.jwt()->>'sub'.
# Create in Clerk Dashboard via Supabase integration, or match your JWT template name.
# CLERK_SUPABASE_JWT_TEMPLATE=supabase

# --- Supabase (Database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/worker: use one of the following (Dashboard → Project Settings → API: secret key)
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_KEY=
# Optional: direct Postgres password for Supabase CLI (`supabase link` / `db push`), not used by the Next.js app at runtime
# SUPABASE_DB_PASSWORD=

# --- USDA FoodData Central (server-only; never NEXT_PUBLIC_*) ---
# USDA_FDC_API_KEY=
# FDC_API_KEY=
# Max outbound USDA HTTP calls per UTC hour (default 900 if unset); uses fdc_api_hourly_usage + fdc_reserve_outbound_slot
# FDC_HOURLY_SOFT_CAP=900

# --- FDC bulk CSV import (npm run import:fdc) ---
# FDC_FOUNDATION_CSV_DIR=
# FDC_SR_LEGACY_CSV_DIR=

# --- OpenAI (server-only; not exposed to browser) ---
# OPENAI_AUDIO_TRANSCRIPTION_KEY=
# OPENAI_REASONING_API_KEY=
# Nutrition AI fallback: optional; if unset, OPENAI_REASONING_API_KEY is used when present
# NUTRITION_ESTIMATE_OPENAI_API_KEY=

# Video worker tuning uses defaults in lib/vision/config.ts and scripts/process-video-jobs.ts.

# --- Stripe (Billing / Subscriptions) ---
# Test keys from Dashboard → Developers → API keys
# Prefer restricted keys (rk_test_...) for server when possible; never commit real secrets.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# App URL used for Checkout success/cancel + Customer Portal return
NEXT_PUBLIC_APP_URL=http://localhost:3000
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (or Dashboard webhook signing secret)
# STRIPE_WEBHOOK_SECRET=
# HomeRecipe paid-plan Price IDs (must match key mode: test vs live)
# These are your two customer billing options — not a Stripe account plan.
STRIPE_PRICE_ID_HOMERECIPE_MONTHLY=
STRIPE_PRICE_ID_HOMERECIPE_YEARLY=
