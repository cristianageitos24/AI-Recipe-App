# Video processing worker: Node + ffmpeg + Tesseract + yt-dlp (matches VIDEO_UPLOAD_SETUP.md)
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    ffmpeg \
    pkg-config \
    python3 \
    libopencv-dev \
    tesseract-ocr \
    tesseract-ocr-eng \
  && curl -fsSL -o /usr/local/bin/yt-dlp \
    "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" \
  && chmod a+rx /usr/local/bin/yt-dlp \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Rebuild image after changing scripts/process-video-jobs.ts or lib/* (COPY bakes code at build time).
COPY . .

ENV NODE_ENV=production

CMD ["npm", "run", "worker:video"]
